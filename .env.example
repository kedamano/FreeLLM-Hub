# FreeLLM Hub Environment Configuration
# Copy this file to .env and fill in your values

# Gateway settings
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=0

# Database
DATABASE_PATH=${APPDATA}/freellm-hub/data.db

# Logging
LOG_LEVEL=info
LOG_DIR=${APPDATA}/freellm-hub/logs
# gateway.N.log rotation: roll once a file passes LOG_MAX_SIZE_MB, keep LOG_MAX_FILES of them
LOG_MAX_SIZE_MB=10
LOG_MAX_FILES=5

# Provider API Keys (optional - can be set in UI)
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# HUGGINGFACE_TOKEN=

# Local model endpoints
# OLLAMA_BASE_URL=http://localhost:11434
# LMSTUDIO_BASE_URL=http://localhost:1234
