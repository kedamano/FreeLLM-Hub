# Normalise line endings so a checkout on Windows and CI on Linux agree.
* text=auto

*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

*.ico binary
*.png binary
*.jpg binary
*.exe binary
*.node binary
