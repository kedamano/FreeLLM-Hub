{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/main/**/*", "src/core/**/*", "src/shared/**/*", "src/usage/**/*", "src/scheduler/**/*", "src/preload/**/*", "src/server/**/*"],
  "exclude": ["node_modules", "dist", "tests", "src/renderer"]
}
